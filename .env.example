# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# JWT Secret (change in production)
JWT_SECRET=your-secret-key-change-this-in-production

# Database (optional - currently using in-memory storage)
# MONGODB_URI=mongodb://localhost:27017/remixxxxxx

# Email Configuration (optional - for password reset emails)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-password

# Push Notification Configuration (optional)
# PUSH_NOTIFICATION_KEY=your-key-here
